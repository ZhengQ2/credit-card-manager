{
  "name": "card-ledger-owner-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Card Ledger API: accounts, Plaid connections and webhooks. Plaid tokens are sealed with KMS; transactions are streamed to the iPhone and never stored here.",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "start": "node src/server.ts",
    "setup": "node src/setup.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "import-vault": "node src/importVault.ts",
    "invite": "node src/invites.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1172.0",
    "@aws-sdk/client-kms": "^3.1172.0",
    "@aws-sdk/client-sesv2": "^3.1172.0",
    "@aws-sdk/client-ssm": "^3.1172.0",
    "@aws-sdk/lib-dynamodb": "^3.1172.0",
    "@simplewebauthn/server": "^13.3.3",
    "otpauth": "^9.6.0",
    "plaid": "^51.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
